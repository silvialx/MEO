PREFIX ex:     <http://www.github.com/silvialx/MEO/>
PREFIX argont: <http://www.github.com/argumentsontology/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>

SELECT ?positionName ?axisPropertyName 
       ?stance ?stanceDefinition
       ?authorName ?authorSeeAlso
WHERE {
  BIND(ex:ErrorTheory AS ?position)

  ?position ?axisProperty ?stance .
  ?axisProperty rdfs:subPropertyOf argont:hasSupposition .

  OPTIONAL { ?axisClass rdfs:comment ?axisComment }
  OPTIONAL { ?stance skos:definition ?stanceDefinition }

  OPTIONAL {
    ?author a ex:Philosopher ;
            argont:supports ?position .
    OPTIONAL { ?author rdfs:seeAlso ?authorSeeAlso }
  }
BIND(STRAFTER(STR(?position), "MEO/") AS ?positionName)
BIND(STRAFTER(STR(?axisProperty), "MEO/") AS ?axisPropertyName)
BIND(STRAFTER(STR(?author), "MEO/") AS ?authorName)
}
ORDER BY ?axisProperty
